---
// The clickable frontend mock (web/), built with the mock API and served
// under <base>/app/ on the same Pages site. It renders at a desktop size
// and is scaled down to fit the page, so the layout matches the real app.
interface Props { path?: string; width?: number; height?: number }
const { path = "", width = 1440, height = 900 } = Astro.props;
const src = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/app/${path}`;
---

<div class="frame not-content">
  <div class="bar">
    <span class="tb-muted">Live mock · fake data, generated in your browser · shown at {width}×{height}</span>
    <a href={src} target="_blank" rel="noopener">Open full screen ↗</a>
  </div>
  <div class="viewport" style={`aspect-ratio:${width}/${height}`} data-width={width}>
    <iframe src={src} title="Tabush frontend mock" loading="lazy" width={width} height={height} data-testid="live-mock"></iframe>
  </div>
</div>

<script>
  for (const vp of document.querySelectorAll<HTMLElement>(".viewport[data-width]")) {
    const frame = vp.querySelector("iframe")!;
    const fit = () => (frame.style.transform = `scale(${vp.clientWidth / Number(vp.dataset.width)})`);
    new ResizeObserver(fit).observe(vp);
    fit();
  }
</script>

<style>
  .frame { border: 1px solid var(--sl-color-gray-5); border-radius: 0.75rem; overflow: hidden; margin-block: 1rem; }
  .bar { display: flex; justify-content: space-between; gap: 1rem; padding: 0.5rem 0.75rem; background: var(--sl-color-bg-nav); border-bottom: 1px solid var(--sl-color-gray-5); }
  .viewport { position: relative; overflow: hidden; }
  iframe { position: absolute; inset: 0 auto auto 0; border: 0; background: white; transform-origin: 0 0; }
</style>
