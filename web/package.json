{
  "name": "tabush-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:contrast": "node scripts/check-contrast.mjs",
    "e2e:data": "cd .. && TABUSH_DATA_DIR=data/e2e uv run python -m tabush.semantic.fixture",
    "e2e": "bddgen && playwright test",
    "e2e:llm": "E2E_LLM=1 TABUSH_OPEN_DIR=${TABUSH_OPEN_DIR:-../data/open} bddgen && E2E_LLM=1 TABUSH_OPEN_DIR=${TABUSH_OPEN_DIR:-../data/open} playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@duckdb/duckdb-wasm": "^1.32.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "lucide-react": "^1.70.0",
    "maplibre-gl": "^6.17.0",
    "pmtiles": "^4.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/geojson": "^7946.0.16",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "playwright-bdd": "^9.2.1",
    "sirv": "^3.0.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  }
}
